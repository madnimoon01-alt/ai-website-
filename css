/* ============================================================
   APEX MOTORS — Showroom
   Palette: charcoal floor, chrome hairlines, ignition red,
   turn-signal amber. Type: Oswald (signage) / Inter (body) /
   JetBrains Mono (spec-sheet numerals).
   ============================================================ */

:root {
  --bg-deep:      #15171a;
  --bg-panel:     #1e2125;
  --bg-panel-alt: #24272c;
  --line:         #34393f;
  --line-bright:  #4a5158;
  --text-main:    #f2efe9;
  --text-dim:     #9aa1a8;
  --text-faint:   #666d74;
  --accent-red:   #d6282f;
  --accent-red-dim: #7a1a1e;
  --accent-amber: #f0a202;

  --font-display: 'Oswald', sans-serif;
  --font-body: 'Inter', sans-serif;
  --font-mono: 'JetBrains Mono', monospace;

  --mx: 50%;
  --my: 50%;
}

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  margin: 0;
  background: var(--bg-deep);
  color: var(--text-main);
  font-family: var(--font-body);
  line-height: 1.5;
  position: relative;
  overflow-x: hidden;
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  * { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
}

/* ---------- ambient showroom floor spotlight ---------- */
.floor-glow {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background:
    radial-gradient(600px circle at var(--mx) var(--my),
      rgba(214, 40, 47, 0.10), transparent 60%),
    repeating-linear-gradient(90deg, rgba(255,255,255,0.015) 0 1px, transparent 1px 120px);
}

/* ---------- header ---------- */
.site-header {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24px clamp(20px, 5vw, 64px) 20px;
  border-bottom: 1px solid var(--line);
  flex-wrap: wrap;
  gap: 16px;
}

.logo {
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: var(--font-display);
  font-weight: 600;
  letter-spacing: 0.06em;
  font-size: 1.15rem;
}

.logo-mark { color: var(--accent-red); font-size: 0.8rem; }

.filters {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.filter-btn {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--text-dim);
  background: transparent;
  border: 1px solid var(--line);
  padding: 8px 14px;
  border-radius: 2px;
  cursor: pointer;
  transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
}

.filter-btn:hover { color: var(--text-main); border-color: var(--line-bright); }

.filter-btn.active {
  color: var(--bg-deep);
  background: var(--accent-red);
  border-color: var(--accent-red);
}

.filter-btn:focus-visible,
.card:focus-visible,
.modal-close:focus-visible {
  outline: 2px solid var(--accent-amber);
  outline-offset: 2px;
}

/* ---------- hero ---------- */
.hero {
  position: relative;
  z-index: 2;
  padding: clamp(48px, 8vw, 96px) clamp(20px, 5vw, 64px) 56px;
  max-width: 900px;
}

.hero-eyebrow {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  letter-spacing: 0.18em;
  color: var(--accent-amber);
  margin: 0 0 18px;
}

.hero-title {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: clamp(2.6rem, 8vw, 5.2rem);
  line-height: 0.98;
  letter-spacing: -0.01em;
  margin: 0 0 20px;
  text-transform: uppercase;
}

.hero-sub {
  font-size: 1.05rem;
  color: var(--text-dim);
  max-width: 46ch;
  margin: 0 0 36px;
}

.hero-odometer {
  display: inline-flex;
  align-items: baseline;
  gap: 12px;
  border: 1px solid var(--line);
  background: var(--bg-panel);
  padding: 10px 18px;
  border-radius: 2px;
}

.odometer-value {
  font-family: var(--font-mono);
  font-size: 1.4rem;
  font-weight: 700;
  color: var(--accent-red);
}

.odometer-label {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  letter-spacing: 0.12em;
  color: var(--text-faint);
  text-transform: uppercase;
}

/* ---------- showroom grid ---------- */
.showroom {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 28px;
  padding: 0 clamp(20px, 5vw, 64px) 80px;
  max-width: 1400px;
  margin: 0 auto;
}

.card {
  position: relative;
  background: var(--bg-panel);
  border: 1px solid var(--line);
  border-radius: 3px;
  overflow: hidden;
  cursor: pointer;
  transition: border-color 0.2s ease, transform 0.2s ease;
  display: flex;
  flex-direction: column;
}

.card:hover,
.card:focus-visible {
  border-color: var(--line-bright);
  transform: translateY(-3px);
}

.card-media {
  position: relative;
  aspect-ratio: 16 / 10;
  background: var(--bg-panel-alt);
  overflow: hidden;
}

.card-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.card-media .placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-mono);
  font-size: 0.7rem;
  letter-spacing: 0.1em;
  color: var(--text-faint);
  text-align: center;
  padding: 12px;
  background:
    linear-gradient(135deg, var(--bg-panel-alt) 25%, transparent 25%) -10px 0/20px 20px,
    linear-gradient(225deg, var(--bg-panel-alt) 25%, transparent 25%) -10px 0/20px 20px,
    var(--bg-deep);
}

.card-class-tag {
  position: absolute;
  top: 12px;
  left: 12px;
  font-family: var(--font-mono);
  font-size: 0.65rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  background: var(--accent-amber);
  color: var(--bg-deep);
  padding: 4px 9px;
  border-radius: 2px;
  font-weight: 700;
}

.card-price-tag {
  position: absolute;
  top: 0;
  right: 18px;
  background: var(--accent-red);
  color: var(--text-main);
  font-family: var(--font-mono);
  font-weight: 700;
  font-size: 0.85rem;
  padding: 8px 12px 10px;
  clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 84%, 0 100%);
}

.card-body {
  padding: 20px 20px 22px;
  border-top: 1px dashed var(--line);
  flex: 1;
  display: flex;
  flex-direction: column;
}

.card-make {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  letter-spacing: 0.14em;
  color: var(--text-faint);
  text-transform: uppercase;
  margin: 0 0 2px;
}

.card-model {
  font-family: var(--font-display);
  font-size: 1.5rem;
  font-weight: 600;
  margin: 0 0 8px;
  text-transform: uppercase;
}

.card-tagline {
  color: var(--text-dim);
  font-size: 0.9rem;
  margin: 0 0 16px;
}

.card-specs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px 14px;
  margin-top: auto;
  padding-top: 14px;
  border-top: 1px solid var(--line);
}

.spec {
  display: flex;
  flex-direction: column;
}

.spec-value {
  font-family: var(--font-mono);
  font-weight: 700;
  font-size: 0.95rem;
  color: var(--text-main);
}

.spec-label {
  font-family: var(--font-mono);
  font-size: 0.62rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--text-faint);
}

/* ---------- modal ---------- */
.modal {
  position: fixed;
  inset: 0;
  z-index: 10;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 24px;
}

.modal.open { display: flex; }

.modal-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(10, 11, 12, 0.82);
  backdrop-filter: blur(3px);
}

.modal-panel {
  position: relative;
  z-index: 1;
  background: var(--bg-panel);
  border: 1px solid var(--line-bright);
  max-width: 640px;
  width: 100%;
  max-height: 88vh;
  overflow-y: auto;
  border-radius: 3px;
  animation: modal-in 0.18s ease;
}

@keyframes modal-in {
  from { opacity: 0; transform: translateY(8px) scale(0.98); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.modal-close {
  position: absolute;
  top: 14px;
  right: 14px;
  z-index: 2;
  background: rgba(21, 23, 26, 0.7);
  border: 1px solid var(--line);
  color: var(--text-main);
  width: 34px;
  height: 34px;
  border-radius: 2px;
  cursor: pointer;
  font-size: 1.1rem;
  line-height: 1;
}

.modal-close:hover { background: var(--accent-red); border-color: var(--accent-red); }

.modal-media {
  aspect-ratio: 16 / 9;
  background: var(--bg-panel-alt);
  overflow: hidden;
}

.modal-media img { width: 100%; height: 100%; object-fit: cover; display: block; }

.modal-body { padding: 26px 28px 30px; }

.modal-desc {
  color: var(--text-dim);
  font-size: 0.95rem;
  margin: 14px 0 22px;
}

.modal-specs {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14px 20px;
  background: var(--bg-panel-alt);
  border: 1px solid var(--line);
  padding: 16px 18px;
  border-radius: 2px;
}

/* ---------- footer ---------- */
.site-footer {
  position: relative;
  z-index: 2;
  text-align: center;
  padding: 28px 20px 40px;
  color: var(--text-faint);
  font-size: 0.78rem;
  border-top: 1px solid var(--line);
}
